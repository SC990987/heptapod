# Minimal condor configuration for submitting from a cmslpc interactive node when the
# submitting process runs outside the coffea-dask apptainer image (a notebook in your
# own virtual environment, for instance).
#
# It mirrors /etc/condor/config.d/01_cmslpc_interactive but leaves out the
#   include : /usr/local/bin/cmslpc-local-conf.py |
# directive, which points LOCAL_CONFIG_FILE at a per-user file that does not exist on
# every node. scaleout.make_lpc_client sets CONDOR_CONFIG to this file.
#
# If the LPC changes its pool, compare with the system file above and update this one.

FERMIHTC_REMOTE_POOL = cmst1mgr2.fnal.gov, cmst1mgr3.fnal.gov
COLLECTOR_HOST = $(FERMIHTC_REMOTE_POOL)
CONDOR_HOST = $(FERMIHTC_REMOTE_POOL)
TOOL_TIMEOUT_MULTIPLIER = 5
CONDOR_Q_DASH_BATCH_IS_DEFAULT = FALSE
JOB_DEFAULT_REQUESTMEMORY = 2048

SEC_DEFAULT_AUTHENTICATION_METHODS = FS_REMOTE
SEC_CLIENT_AUTHENTICATION_METHODS = FS_REMOTE
FS_REMOTE_DIR = /uscmst1b_scratch/lpc1/htcondor/

FERMIHTC_JOB_SOURCE = "$(HOSTNAME)"
SUBMIT_ATTRS = $(SUBMIT_ATTRS) FERMIHTC_JOB_SOURCE
